---
layout: layouts/base.njk
title: "David Bograd: Product Designer"
socialImage: david-bush.jpg
bodyClass: is-work
---

<section class="hero">
  {% if site.show.heroGraphics and site.show.work %}
  <a class="dial" href="#work">
    <svg class="dial__ring" viewBox="0 0 200 200" aria-hidden="true">
      {% for i in range(0, 72) %}
      <line x1="100" y1="3" x2="100" y2="{{ 15 if i % 6 == 0 else 10 }}" transform="rotate({{ i * 5 }} 100 100)"/>
      {% endfor %}
    </svg>
    <span class="dial__label">Selected work</span>
  </a>
  {% endif %}

  <div class="shell">
    <h1 class="hero__title" data-split-words>
      I&rsquo;m a Product designer<br>
      making <em data-sparkle>beautiful software</em>.
    </h1>

    <div class="hero__roles">
      <div class="hero__role">
        <p class="hero__role-label">Currently</p>
        <p class="hero__role-text">
          Looking for my next role.<br>
          Remote or <span data-cursor="au-cursor">Perth, Australia</span>.
        </p>
      </div>
      <div class="hero__role">
        <p class="hero__role-label">Previously</p>
        <p class="hero__role-text">
          Design @ <span data-preview="canva-preview">Canva</span>, <span data-preview="envato-preview">Envato</span>, <span data-preview="betashares-preview">Betashares</span> and more. Over 12 years of design experience.
        </p>
      </div>
    </div>
  </div>

  {# These stand in for the pointer over "Perth, Australia" and the company
     names. They picture words already on the page, so they carry no alt text. #}
  <span class="cursor-chip" id="au-cursor" aria-hidden="true">
    <span class="cursor-chip__inner">{% include "partials/flag-au.svg" %}</span>
  </span>
  <span class="cursor-chip cursor-chip--preview" id="canva-preview" aria-hidden="true">
    <span class="cursor-chip__inner"><img src="/assets/img/preview-canva.jpg" alt="" width="1200" height="630"></span>
  </span>
  <span class="cursor-chip cursor-chip--preview" id="envato-preview" aria-hidden="true">
    <span class="cursor-chip__inner"><img src="/assets/img/preview-envato.jpg" alt="" width="1600" height="840"></span>
  </span>
  <span class="cursor-chip cursor-chip--preview" id="betashares-preview" aria-hidden="true">
    <span class="cursor-chip__inner"><img src="/assets/img/preview-betashares.jpg" alt="" width="4058" height="2000"></span>
  </span>

  {% if site.show.heroGraphics %}{% include "partials/collage.njk" %}{% endif %}
</section>

<section class="section work" id="work">
  <div class="work-list">
    {% set studies = collections.casesVisible if site.show.work else collections.casesPlaceholder %}
    {% for item in studies %}
    {% set anchor = item.data.anchor or item.fileSlug %}
    {% set company = item.data.company or item.data.cardTitle %}
    <article class="study" id="{{ anchor }}" style="--case-accent: {{ item.data.accent }}">
      {% if item.url %}<a class="study__link" href="{{ item.url }}">{% endif %}
        <span class="study__visual{% if not item.data.cover and not item.data.thumb %} study__visual--empty{% endif %}">
          {% if item.data.cover or item.data.thumb %}
          {% image item.data.cover or item.data.thumb, item.data.coverAlt or company, "work", loop.first %}
          {% else %}
          <p class="work-soon__label">Coming soon</p>
          {% endif %}
        </span>
        <p class="study__meta">
          <span class="study__company">{{ company }}</span>
          {% if item.data.years %}<span class="study__years">{{ item.data.years }}</span>{% endif %}
        </p>
      {% if item.url %}</a>{% endif %}
    </article>
    {% endfor %}
  </div>
</section>

<section class="section" id="about">
  <div class="shell">
    <div class="about__grid">
      <div class="about__text">
        <h2 class="about__label">About me</h2>
        <p>
          I most recently designed at <a class="link--canva" href="https://www.canva.com/" target="_blank" rel="noopener">Canva</a>, a design tool with over 265 million monthly users.
        </p>
        <p>
          Throughout my 12+ year of experience I&rsquo;ve worked for a handful of tech companies, designed websites and for clients such as Microsoft, and freelanced for more than 100 clients.
        </p>
        <p>
          When not working, I like to stay active and spend time at the gym. If it&rsquo;s windy I&rsquo;ll be on the water kitesurfing.
        </p>
        <p>I&rsquo;m based in Perth, Australia but originate from Copenhagen, Denmark.</p>
      </div>

      <div class="about__aside">
        <figure class="about__photo">
          {% image "david-wall.jpg", "David Bograd", "aboutPhoto" %}
        </figure>

        <div class="about__contact">
          <p>Don&rsquo;t be a stranger&mdash;Reach me at</p>
          <a class="about__email" href="mailto:{{ site.email }}">&rarr; {{ site.email }}</a>
          <p class="about__ps">PS. I don&rsquo;t always pose awkwardly in front of walls.</p>
        </div>

        <div class="about__social">
          {% for link in site.social %}
          <a class="pill" href="{{ link.url }}" target="_blank" rel="noopener">{{ link.label }}</a>
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
</section>

<section class="section" id="experience">
  <div class="shell">
    <h2 class="about__label">Experience</h2>
    <div class="jobs">
      {% set roles = [
        { company: "Canva", href: "https://www.canva.com/", years: "2025 - 2026", role: "Product Designer", logo: "logo-canva.png" },
        { company: "Simply Wall St", href: "https://simplywall.st/", years: "2024 - 2025", role: "Senior Product Designer", logo: "logo-simplywallst.png" },
        { company: "Betashares", href: "https://www.betashares.com.au/", years: "2021 - 2023", role: "Senior Product Designer", logo: "logo-betashares-icon.png" },
        { company: "Envato", href: "https://www.envato.com/", years: "2019 - 2021", role: "Senior Product Designer", logo: "logo-envato-icon.png" },
        { company: "Epidemic Sound", href: "https://www.epidemicsound.com/", years: "2017 - 2019", role: "Product Designer", logo: "logo-epidemic-icon.png" },
        { company: "Various startups and agencies", years: "2014 - 2017", role: "Junior Designer" }
      ] %}
      {% for item in roles %}
      <div class="job">
        {% if item.logo %}
        <span class="job__logo">{% image item.logo, "", "job" %}</span>
        {% else %}
        <span class="job__logo job__logo--mark" aria-hidden="true"><span></span><span></span><span></span></span>
        {% endif %}
        <div class="job__body">
          <div class="job__line">
            <p class="job__title">{{ item.role }}</p>
            <span class="job__lead" aria-hidden="true"></span>
            <p class="job__dates">{{ item.years }}</p>
          </div>
          <p class="job__company">
            {% if item.href %}<a href="{{ item.href }}" target="_blank" rel="noopener">{{ item.company }}</a>{% else %}{{ item.company }}{% endif %}
          </p>
        </div>
      </div>
      {% endfor %}
    </div>
  </div>
</section>

<section class="section" id="side-projects">
  <div class="shell">
    <h2 class="about__label">Side projects</h2>
    <div class="cv">
      {% set projects = [
        { name: "Fysfinder", href: "https://www.fysfinder.dk/", years: "2025 - today", detail: "Over 100,000 people has used Fysfinder to find a physio in Denmark. I’ve designed and built it from scratch using AI coding." },
        { name: "Do Good Movement", href: "https://dogoodmovement.earth/", years: "2022 - 2025", detail: "Started a charity with two friends. We had ~500 members and donated a total of ~$65,000 AUD to help 14,702 in need." }
      ] %}
      {% for item in projects %}
      <div class="cv__row">
        <div class="cv__left">
          {% if item.href %}
          <a class="cv__company" href="{{ item.href }}" target="_blank" rel="noopener">
            {{ item.name }}
            <svg class="cv__arrow" width="11" height="11" viewBox="0 0 10 10" fill="none" aria-hidden="true">
              <path d="M3 7L7 3M3.5 3H7V6.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
          {% else %}
          <span class="cv__company">{{ item.name }}</span>
          {% endif %}
          <span class="cv__years">{{ item.years }}</span>
        </div>
        <div class="cv__role">
          <p class="cv__title">{{ item.detail }}</p>
        </div>
      </div>
      {% endfor %}
    </div>
  </div>
</section>
