<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">

<title>{{ title }}</title>
<meta name="description" content="{{ description or site.description }}">
{% if hidden %}<meta name="robots" content="noindex, nofollow">{% endif %}

<meta property="og:type" content="website">
<meta property="og:title" content="{{ title }}">
<meta property="og:description" content="{{ description or site.description }}">
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
{% if socialImage %}<meta property="og:image" content="{{ site.url }}/assets/img/{{ socialImage }}">{% endif %}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ title }}">
<meta name="twitter:description" content="{{ description or site.description }}">
{% if socialImage %}<meta name="twitter:image" content="{{ site.url }}/assets/img/{{ socialImage }}">{% endif %}

<link rel="canonical" href="{{ site.url }}{{ page.url }}">
<link rel="icon" href="/assets/img/favicon-portfolio.png">
<link rel="apple-touch-icon" href="/assets/img/favicon-portfolio.png">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,300..800;1,14..32,300..800&family=JetBrains+Mono:wght@400;500&family=Instrument+Serif:ital@0;1&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/assets/css/style.css">

<script>
  // Set the theme before first paint so there is no flash of the wrong theme.
  (function () {
    try {
      var stored = localStorage.getItem("theme");
      var theme = stored || (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
      document.documentElement.setAttribute("data-theme", theme);
    } catch (e) {}
  })();
</script>
</head>

<body class="{{ bodyClass }}">
<a class="skip-link" href="#main">Skip to content</a>

{% include "partials/nav.njk" %}

<main id="main">
  {{ content | safe }}
</main>

{% include "partials/footer.njk" %}

<script src="/assets/js/theme.js" defer></script>
</body>
</html>
