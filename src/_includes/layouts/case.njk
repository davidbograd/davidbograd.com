---
layout: layouts/base.njk
---
{% set companyName = company or (tags_display[1] if (tags_display | length) > 1 else cardTitle) %}
{% if placeholder %}
<article class="case case--empty" style="--case-accent: {{ accent }}">
  <h1 class="case-name"{% if titleSize %} style="--title-size: {{ titleSize }}"{% endif %}><span>{{ companyName }}</span></h1>
  {% if years %}<p class="case-years">{{ years }}</p>{% endif %}
  <header class="case-hero">
    <div class="shell">
      <p class="case-empty__note">This write-up is on its way.</p>
    </div>
  </header>

  <div class="shell">
    <div class="case-empty__panel">
      <p class="work-soon__label">Coming soon</p>
    </div>
  </div>
</article>
{% else %}
<article class="case{% if bleed %} case--bleed{% endif %}" style="--case-accent: {{ accent }}">

  <h1 class="case-name"{% if titleSize %} style="--title-size: {{ titleSize }}"{% endif %}><span>{{ companyName }}</span></h1>
  {% if years %}<p class="case-years">{{ years }}</p>{% endif %}

  <header class="case-hero">
    <div class="shell">
      <div class="case-hero__intro">
        {% for paragraph in intro %}<p>{{ paragraph | safe }}</p>{% endfor %}
      </div>

      {% if meta %}
      <dl class="case-meta">
        {% for item in meta %}
        <div class="case-meta__item">
          <dt class="eyebrow">{{ item.label }}</dt>
          <dd class="case-meta__value">{{ item.value | safe }}</dd>
        </div>
        {% endfor %}
      </dl>
      {% endif %}
    </div>
  </header>

  {% if cover %}
  <div class="shell">
    <figure class="case-cover reveal{% if coverBrowser %} browser{% endif %}">
      {% if coverBrowser %}
      <div class="browser__bar">
        <span class="browser__dots" aria-hidden="true"><i></i><i></i><i></i></span>
        <span class="browser__url"></span>
      </div>
      {% endif %}
      {% image cover, coverAlt or "", "bleed" if bleed else "cover", true %}
    </figure>
  </div>
  {% endif %}

  <div class="case-body">
    <div class="shell">
      <div class="case-body__inner">
        {{ content | safe }}
      </div>
    </div>
  </div>

</article>
{% endif %}

{% set studies = collections.casesVisible if site.show.work else collections.casesPlaceholder %}
{% set others = studies | otherCases(page.url) %}
{% if others.length and not placeholder %}
<aside class="more-cases">
  <div class="shell">
    <div class="section-head">
      <h2 class="section-head__title">More case studies</h2>
    </div>

    <div class="more-cases__grid">
      {% asyncEach item in others %}
      {% set cardEager = false %}
      {% include "partials/study-card.njk" %}
      {% endeach %}
    </div>
  </div>
</aside>
{% endif %}
