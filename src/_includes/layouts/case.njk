---
layout: layouts/base.njk
---
{% set companyName = company or (tags_display[1] if (tags_display | length) > 1 else cardTitle) %}
{% if placeholder %}
<article class="case case--empty" style="--case-accent: {{ accent }}">
  <h1 class="case-name"><span>{{ companyName }}</span></h1>
  <header class="case-hero">
    <div class="shell">
      <p class="case-empty__note">This write-up is on its way.</p>
    </div>
  </header>

  <div class="shell">
    <div class="case-empty__panel">
      <p class="work-soon__label">Coming soon</p>
    </div>
  </div>
</article>
{% else %}
<article class="case" style="--case-accent: {{ accent }}">

  <h1 class="case-name"><span>{{ companyName }}</span></h1>

  <header class="case-hero">
    <div class="shell">
      {% if heading != companyName %}
      <h2 class="case-hero__title">{{ heading }}</h2>
      {% endif %}

      <div class="case-hero__intro">
        {% for paragraph in intro %}<p>{{ paragraph | safe }}</p>{% endfor %}
      </div>

      {% if meta %}
      <dl class="case-meta">
        {% for item in meta %}
        <div class="case-meta__item">
          <dt class="eyebrow">{{ item.label }}</dt>
          <dd class="case-meta__value">{{ item.value | safe }}</dd>
        </div>
        {% endfor %}
      </dl>
      {% endif %}
    </div>
  </header>

  {% if cover %}
  <div class="shell">
    <figure class="case-cover reveal">
      {% image cover, coverAlt or "", "cover", true %}
    </figure>
  </div>
  {% endif %}

  <div class="case-body">
    <div class="shell">
      <div class="case-body__inner">
        {{ content | safe }}
      </div>
    </div>
  </div>

</article>
{% endif %}

{% set others = collections.cases | otherCases(page.url) %}
{% if others.length and not placeholder %}
<aside class="more-cases">
  <div class="shell">
    <div class="section-head">
      <h2 class="section-head__title">More case studies</h2>
    </div>

    <div class="more-cases__grid">
      {% for item in others %}
      <a class="more-card reveal" href="{{ item.url }}">
        <div class="more-card__media">
          {% image item.data.thumb, "", "moreCard" %}
        </div>
        <div class="more-card__body">
          <span class="eyebrow case-card__tag">
            <span class="case-card__dot" style="background: {{ item.data.accent }}"></span>
            {{ item.data.tags_display[0] }}
          </span>
          <span class="more-card__title">{{ item.data.cardTitle }}</span>
        </div>
      </a>
      {% endfor %}
    </div>
  </div>
</aside>
{% endif %}
