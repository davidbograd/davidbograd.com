{# Placeholder pieces after timeless.co/type. Purely decorative, so the whole
   strip is hidden from assistive tech. Positions and sizes are in `em` on the
   canvas, so the composition scales as one. #}
<div class="collage" data-pan aria-hidden="true">
  <div class="collage__canvas">

    <div class="pc pc--doc" style="--x: 0; --y: 3; --w: 16; --h: 20.5; --i: 0">
      <div class="pc-doc__head"><span>Envato Market</span><span>N.01</span></div>
      <p class="pc-doc__title">Design QC</p>
      <div class="pc-doc__cols">
        <p>Over two million items arrive every year, and every one of them is reviewed by hand before it goes on sale. The old tool was slow, crashed often and strained reviewers&rsquo; eyes after a long day.</p>
        <p>We rebuilt it from scratch in six months around one idea: speed. A dark interface for all-day use, bulk actions for clear rejections, and an undo for the moments everyone has.</p>
      </div>
      <div class="pc-doc__rings"><i></i><i></i><i></i><i></i></div>
    </div>

    <div class="pc pc--cover" style="--x: 10; --y: 12.5; --w: 16; --h: 20.5; --i: 1">
      <p class="pc-cover__kicker">Review tool for one of the world&rsquo;s leading creative marketplaces</p>
      <div class="pc-cover__art"><i></i><i></i><i></i></div>
      <p class="pc-cover__title">Case study<br>&amp; process</p>
      <div class="pc-cover__foot"><span>David Bograd</span><span>N.01</span></div>
    </div>

    <div class="pc pc--flight" style="--x: 18.5; --y: 0.5; --w: 19; --h: 5.8; --i: 2">
      <div class="pc-flight__row pc-flight__row--small"><span>Perth</span><span>Copenhagen</span></div>
      <div class="pc-flight__row pc-flight__row--big">
        <span>PER</span>
        <span class="pc-flight__track"><span class="pc-flight__fill"></span><span class="pc-flight__plane"></span></span>
        <span>CPH</span>
      </div>
      <div class="pc-flight__row pc-flight__row--small"><span>9:45 PM</span><span>Arrives in <b>45</b>m</span><span>6:20 AM</span></div>
    </div>

    <div class="pc pc--spread" style="--x: 28; --y: 7.5; --w: 23; --h: 16.5; --i: 3">
      <div class="pc-spread__page pc-spread__page--art">
        <i class="pc-spread__sun"></i><i class="pc-spread__block"></i><i class="pc-spread__arch"></i>
      </div>
      <div class="pc-spread__page pc-spread__page--words">
        <p>Simple<br>Thoughtful<br><em>Useful</em><br>Beautiful<br>Accessible<br><em>Delightful</em></p>
        <span>Principles &mdash; 03</span>
      </div>
    </div>

    <div class="pc pc--music" style="--x: 53; --y: 1.5; --w: 13.25; --h: 16.5; --i: 4">
      <div class="pc-music__art"><span>Soundry</span></div>
      <div class="pc-music__meta">
        <p><b>Soundry</b><span>Music for public spaces</span></p>
        <span class="pc-music__play"><svg viewBox="0 0 24 24"><path d="M8 5.5v13l10.5-6.5Z"/></svg></span>
      </div>
    </div>

    <div class="pc pc--stats" style="--x: 51.5; --y: 20.5; --w: 13.5; --h: 10.6; --i: 5">
      <div class="pc-stats__head"><span>Review queue</span><b>4&times;</b></div>
      <div class="pc-stats__bar"><i></i><i></i><i></i><i></i></div>
      <ul>
        <li><i></i>Accepted<span>1,284</span></li>
        <li><i></i>Soft reject<span>312</span></li>
        <li><i></i>Hard reject<span>96</span></li>
        <li><i></i>Escalated<span>18</span></li>
      </ul>
    </div>

    <div class="pc pc--chat" style="--x: 68.5; --y: 10.5; --w: 12.5; --i: 6">
      <p class="pc-chat__in">Coffee in Perth next week?</p>
      <p class="pc-chat__out">Always. Tuesday?</p>
    </div>

    <div class="pc pc--phone" style="--x: 82; --y: 3.5; --w: 11.5; --h: 22; --i: 7">
      <div class="pc-phone__screen">
        <div class="pc-phone__status"><span>9:41</span><i></i></div>
        <p class="pc-phone__title">Told</p>
        <p class="pc-phone__sub">Stories, read aloud</p>
        <div class="pc-phone__row"><i></i><span></span></div>
        <div class="pc-phone__row"><i></i><span></span></div>
        <div class="pc-phone__row"><i></i><span></span></div>
      </div>
    </div>

    <div class="pc pc--prompt" style="--x: 96; --y: 1; --w: 15.5; --h: 9.5; --i: 8">
      <p>Everyone deserves beautiful software<span class="pc-prompt__caret"></span></p>
      <div class="pc-prompt__bar">
        <span class="pc-prompt__plus">+</span>
        <span class="pc-prompt__send"><svg viewBox="0 0 24 24"><path d="M12 19V5m0 0-6 6m6-6 6 6"/></svg></span>
      </div>
    </div>

    <div class="pc pc--poster" style="--x: 114.5; --y: 4; --w: 18; --h: 25.5; --i: 9">
      <div class="pc-poster__top"><span>2026</span><span>ES&mdash;DS</span></div>
      <p class="pc-poster__big">Design<br><span>systems</span></p>
      <p class="pc-poster__mid">for millions<br>of creators</p>
      <div class="pc-poster__dots"><i></i><i></i><i></i><i></i><i></i></div>
    </div>

    <div class="pc pc--site" style="--x: 136; --y: 0; --w: 19.5; --h: 27; --i: 10">
      <div class="pc-site__image"></div>
      <div class="pc-site__foot">
        <b>davidbograd.com</b>
        <span>A product designer from Copenhagen, based in Perth</span>
      </div>
    </div>

    <div class="pc pc--temp" style="--x: 158; --y: 5; --w: 9; --h: 9; --i: 11">
      <span>Snow depth</span>
      <p>142<small>cm</small></p>
      <span>Niseko</span>
    </div>

  </div>
</div>
